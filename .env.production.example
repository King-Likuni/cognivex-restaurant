PROJECT_NAME="Cognivex Restaurant Platform"
VERSION="0.1.0"
ENVIRONMENT="production"
API_V1_STR="/api/v1"

# Use the pooled Neon connection string for serverless-friendly connection handling.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Optional for the zero-budget deployment. Leave empty while running a single Render instance.
REDIS_URL=""

SECRET_KEY="change-this-to-a-long-random-production-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"
BACKEND_CORS_ORIGINS='["https://your-vercel-app.vercel.app"]'

PAYMENT_WEBHOOK_SECRET="change-this-payment-webhook-secret-at-least-32-chars"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-this-whatsapp-verify-token"
WHATSAPP_WEBHOOK_APP_SECRET="change-this-whatsapp-app-secret-at-least-32-chars"

INITIAL_ADMIN_EMAIL="admin@cognivex.com"
INITIAL_ADMIN_PASSWORD="change-this-admin-password"
ENABLE_SAMPLE_DATA="false"

RUN_MIGRATIONS="1"
RUN_INITIAL_DATA="0"
WEB_CONCURRENCY="1"
