PROJECT_NAME="Cognivex Restaurant Platform"
VERSION="0.1.0"
ENVIRONMENT="staging"
API_V1_STR="/api/v1"

POSTGRES_SERVER="db"
POSTGRES_PORT="5432"
POSTGRES_USER="cognivex"
POSTGRES_PASSWORD="change-this-staging-postgres-password"
POSTGRES_DB="cognivex_restaurant"

REDIS_URL="redis://redis:6379/0"
SECRET_KEY="change-this-to-a-long-random-staging-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
BACKEND_CORS_ORIGINS='["http://127.0.0.1:3011","http://localhost:3011"]'

PAYMENT_WEBHOOK_SECRET="change-this-payment-webhook-secret-at-least-32-chars"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-this-whatsapp-verify-token"
WHATSAPP_WEBHOOK_APP_SECRET="change-this-whatsapp-app-secret-at-least-32-chars"

INITIAL_ADMIN_EMAIL="admin@cognivex.com"
INITIAL_ADMIN_PASSWORD="change-this-admin-password"
ENABLE_SAMPLE_DATA="false"
INITIAL_OWNER_EMAIL="owner@chickenspot.com"
INITIAL_OWNER_PASSWORD="change-this-owner-password"

BACKEND_PORT="8011"
FRONTEND_PORT="3011"
VITE_API_BASE_URL="http://127.0.0.1:8011"
RUN_MIGRATIONS="1"
RUN_INITIAL_DATA="0"
WEB_CONCURRENCY="1"
